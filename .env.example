# ─────────────────────────────────────────────
# Supabase
# Trouvez ces valeurs dans : Project Settings → API
# ─────────────────────────────────────────────

# URL du projet Supabase (publique)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Clé anon publique (exposée côté client, sécurisée par RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Clé service_role (PRIVÉE — ne jamais exposer côté client)
# Utilisée uniquement dans les Server Actions / Route Handlers privilégiés
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────

# URL publique de l'application (sans slash final)
NEXT_PUBLIC_APP_URL=http://localhost:3000
